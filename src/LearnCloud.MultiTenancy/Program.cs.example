// {
//     var userId = http.User.FindFirst("uid")?.Value;
//     using var scope = noTenantOp.BeginScope("Platform dashboard listing all tenants", long.Parse(userId!), "PLATFORM_SUPERADMIN");
//     var tenants = await db.Tenants.IgnoreQueryFilters().Where(t=>!t.IsDeleted).ToListAsync();
//     return Results.Ok(tenants);
// }).RequireAuthorization("PLATFORM_SUPERADMIN");

app.Run();

public partial class Program {}
