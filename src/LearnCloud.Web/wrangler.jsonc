// Cloudflare Worker for the LearnCloud web app. Deploy with `npm run deploy`.
// See docs/DEPLOYMENT.md, section 2.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "learncloud-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Paths without a file get index.html, so deep links into the app work.
    "not_found_handling": "single-page-application",
    // Everything else is a static file; only the API proxy needs the Worker.
    "run_worker_first": ["/api/*"]
  },
  // API_ORIGIN and ROOT_DOMAIN are set on the Worker in the dashboard (API_PROXY_SECRET as
  // a secret). Keep them when deploying instead of clearing variables not listed here.
  "keep_vars": true,
  "observability": { "enabled": true }
}
