# Copy to .env.local for local overrides. Cloudflare Pages reads these from the
# project's build environment variables instead.

# Platform domain. On <school>.learncloud.co.zw the sign-in page takes the school from
# the address; leave empty to always ask for the school code (local and preview hosts).
VITE_ROOT_DOMAIN=learncloud.co.zw

# Local dev only: where Vite proxies /api (default http://localhost:5080).
# VITE_API_PROXY_TARGET=http://localhost:5080
