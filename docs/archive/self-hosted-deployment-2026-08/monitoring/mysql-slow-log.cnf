# MySQL slow query log - for monitoring
[mysqld]
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 1
log_throttle_queries_not_using_indexes = 10
min_examined_row_limit = 100

# Structured logging rotation handled by docker json-file max-size
# Error tracking integration via Sentry DSN env var in API, structured logging with Serilog

# For performance on 1.5G RAM
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
max_connections = 100
